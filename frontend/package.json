{
  "name": "campo-minado-frontend",
  "private": true,
  "description": "Ferramentas Elm fixadas para build e testes do Campo Minado",
  "scripts": {
    "build": "elm make src/Main.elm --optimize --output=public/elm.js",
    "format": "elm-format src/ tests/ --yes",
    "check-format": "elm-format src/ tests/ --validate",
    "test": "elm-test"
  },
  "devDependencies": {
    "elm": "0.19.1-5",
    "elm-format": "0.8.7",
    "elm-test": "0.19.1-revision18"
  }
}
